# ============================================================
#  Conversation — Environment Variables
#  এই ফাইলটা কপি করে `.env.local` নাম দিন, তারপর ভ্যালু বসান।
#  `npm run keys` চালালে JWT_SECRET আর MESSAGE_ENCRYPTION_KEY
#  দুটো নিজে থেকেই বানিয়ে দেবে।
# ============================================================

# ─────────── 1. DATABASE (neon.tech → free) ───────────
# Neon dashboard → Connection string → "Pooled connection" (-pooler আছে)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/conversation?sslmode=require"
# একই জায়গা থেকে "Direct connection" (migration চালানোর জন্য)
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/conversation?sslmode=require"


# ─────────── 2. SECRETS (npm run keys) ───────────
# কমপক্ষে ৩২ অক্ষর
JWT_SECRET=""
# ঠিক ৩২ বাইট, base64
MESSAGE_ENCRYPTION_KEY=""


# ─────────── 3. PUSHER (pusher.com → Channels → free) ───────────
# App Keys ট্যাবে সব পাবেন। cluster বাংলাদেশের জন্য: ap2
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
# নিচের দুটো ব্রাউজারে যাবে — KEY টাই, SECRET কখনো নয়
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"


# ─────────── 4. CLOUDINARY (ছবি + ভয়েস নোট, free 25GB) ───────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="conversation"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""


# ─────────── 5. VOICE CALL — TURN (ঐচ্ছিক কিন্তু জরুরি) ───────────
# dash.cloudflare.com → Realtime → TURN → Create
# না দিলে কল শুধু একই WiFi-তে কাজ করবে, আলাদা নেটওয়ার্কে হবে না
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""


# ─────────── 6. SESSION RULES ───────────
IDLE_TIMEOUT_MINUTES="30"
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_MINUTES="15"
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES="30"


# ─────────── 7. অ্যাকাউন্ট (শুধু seed চালানোর জন্য) ───────────
# `npm run db:seed` একবার চালালেই এই দুটো অ্যাকাউন্ট তৈরি হবে
SEED_A_EMAIL="you@ours.app"
SEED_A_PASSWORD=""
SEED_A_NAME="তোমার নাম"

SEED_B_EMAIL="her@ours.app"
SEED_B_PASSWORD=""
SEED_B_NAME="তার নাম"

SEED_ADMIN_EMAIL="admin@ours.app"
SEED_ADMIN_PASSWORD=""


# ─────────── 8. সাজসজ্জা ───────────
NEXT_PUBLIC_APP_NAME="Conversation"
# "কতদিন একসাথে" counter — সম্পর্কের শুরুর তারিখ
NEXT_PUBLIC_ANNIVERSARY_DATE="2024-02-14"

# ─────────── 9. WEB PUSH (ঐচ্ছিক — ফোনে নোটিফিকেশন) ───────────
# npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─────────── 10. ANDROID APK (ঐচ্ছিক — PWABuilder দিয়ে বানানোর পর) ───────────
# APK বানানোর পর ওখান থেকে package name আর SHA-256 fingerprint পাবেন
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_FINGERPRINT=""
