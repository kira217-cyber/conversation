{
  "name": "conversation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "keys": "tsx scripts/generate-keys.ts",
    "db:check": "dotenv -e .env.local -- tsx scripts/check-db.ts",
    "check:pusher": "dotenv -e .env.local -- tsx scripts/check-pusher.ts",
    "check:cloudinary": "dotenv -e .env.local -- tsx scripts/check-cloudinary.ts",
    "check:turn": "dotenv -e .env.local -- tsx scripts/check-turn.ts"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.22.2",
    "framer-motion": "^13.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
